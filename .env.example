# Parali Mitra / KilnLink Environment Configuration Template
# Copy this file to .env or backend/.env and fill in your actual credentials.
# NEVER commit .env to version control or include it in submission archives!

# NASA FIRMS API Key (Free registration at https://firms.modaps.eosdis.nasa.gov/api/map_key)
# Used for live satellite active fire observation feed.
FIRMS_MAP_KEY=YOUR_NASA_FIRMS_MAP_KEY_HERE
NASA_FIRMS_MAP_KEY=YOUR_NASA_FIRMS_MAP_KEY_HERE

# Administrative Secret Key for POST /supply/refresh and administrative operations
ADMIN_KEY=YOUR_ADMIN_SECRET_KEY_HERE

# Optional custom SQLite database path (default: data/kilnlink.db)
# KILNLINK_DB_PATH=data/kilnlink.db

# Optional flag to force clean database re-seeding on startup (0=disabled, 1=enabled)
# RESET_DB=0
